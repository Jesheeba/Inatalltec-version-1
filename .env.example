# ─────────────────────────────────────────────────────────────────
# Supabase - fill these in from your Supabase project dashboard
# (Project Settings → API)
# ─────────────────────────────────────────────────────────────────

# Public - safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Server-only - NEVER expose to the browser. Bypasses RLS.
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# ─────────────────────────────────────────────────────────────────
# Demo / dev toggles
# ─────────────────────────────────────────────────────────────────

# When true, the app skips Supabase auth and renders the UI from the
# bundled seed data so you can click through every screen offline.
# PRODUCTION (Vercel): set to false.
NEXT_PUBLIC_USE_MOCK_DATA=false

# Allows the topbar role switcher in dev so you can preview each
# role's dashboard without creating real users.
# PRODUCTION (Vercel): set to false.
NEXT_PUBLIC_ROLE_SWITCHER=false
